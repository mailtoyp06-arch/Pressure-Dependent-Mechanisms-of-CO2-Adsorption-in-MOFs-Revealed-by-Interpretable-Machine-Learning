# train_forest_model.py
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import joblib
from sklearn.model_selection import train_test_split, GridSearchCV, KFold, cross_val_score, learning_curve
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score

# -------------------------------------------------------
# 1. Load dataset
# -------------------------------------------------------
train_df = pd.read_csv("train_set.csv")
val_df   = pd.read_csv("validation_set.csv")
test_df  = pd.read_csv("test_set.csv")

train_df = train_df.dropna()
val_df   = val_df.dropna()
test_df  = test_df.dropna()

print(f"Train rows: {len(train_df)}, Val rows: {len(val_df)}, Test rows: {len(test_df)}")

# -------------------------------------------------------
# 2. Define features and target
# -------------------------------------------------------

# -------------------------------------------------------
# 3. Split data
# -------------------------------------------------------
target_col = "Loading"

feature_cols = train_df.select_dtypes(include=[np.number]).columns.drop(target_col)

def split_X_y(df, target_col="Loading"):
    X = df.select_dtypes(include=[np.number]).drop(columns=[target_col], errors="ignore")
    y = df[target_col]

    # Always create log_fugacity
    if "Fugacity [Pa]" in X.columns:
        X["log_fugacity"] = np.log1p(X["Fugacity [Pa]"])

    # Always drop raw fugacity
    X = X.drop(columns=["Fugacity [Pa]"], errors="ignore")

    return X, y

X_train, y_train = split_X_y(train_df)
X_val, y_val     = split_X_y(val_df)
X_test, y_test   = split_X_y(test_df)

print("Train shape:", X_train.shape)
print("Test shape:", X_test.shape)
print("Same columns:", list(X_train.columns) == list(X_test.columns))
print("Train minus Test:", set(X_train.columns) - set(X_test.columns))
print("Test minus Train:", set(X_test.columns) - set(X_train.columns))

# -------------------------------------------------------
# 4. Scale features
# -------------------------------------------------------
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_val_scaled   = scaler.transform(X_val)
X_test_scaled  = scaler.transform(X_test)
# -------------------------------------------------------
# 5. Train default Random Forest
# -------------------------------------------------------
#default_rf = RandomForestRegressor(random_state=42)
#default_rf.fit(X_train_scaled, y_train)
rf_model = RandomForestRegressor(
    n_estimators=500,
    max_depth=None,
    min_samples_leaf=5,
    random_state=42,
    n_jobs=-1
)
rf_model.fit(X_train_scaled, y_train)

y_pred_train_default = rf_model.predict(X_train_scaled)
y_pred_test_default  = rf_model.predict(X_test_scaled)

mse_train_default = mean_squared_error(y_train, y_pred_train_default)
mse_test_default  = mean_squared_error(y_test, y_pred_test_default)

r2_train_default = r2_score(y_train, y_pred_train_default)
r2_test_default  = r2_score(y_test, y_pred_test_default)

print("\nDefault RF Performance:")
print(f"Train RMSE: {np.sqrt(mse_train_default):.4f}, R²: {r2_train_default:.4f}")
print(f"Test  RMSE: {np.sqrt(mse_test_default):.4f}, R²: {r2_test_default:.4f}")

# -------------------------------------------------------
# 6. Cross-validation
# -------------------------------------------------------
kf = KFold(n_splits=5, shuffle=True, random_state=42)
cv_r2_rf = cross_val_score(rf_model, X_train_scaled, y_train, cv=kf, scoring='r2')
neg_mse_scores = cross_val_score(rf_model,X_train_scaled,y_train,cv=kf,scoring='neg_mean_squared_error')
cv_rmse_rf = np.sqrt(-neg_mse_scores)

print(f"\nRF CV R²: {cv_r2_rf.mean():.4f} ± {cv_r2_rf.std():.4f}")
print(f"RF CV RMSE: {cv_rmse_rf.mean():.4f} ± {cv_rmse_rf.std():.4f}")

# -------------------------------------------------------
# 7. GridSearchCV for hyperparameter tuning
# -------------------------------------------------------
param_grid = {
    'n_estimators':[300, 600, 900],
    'max_depth':[5, 10, 15, 20],
    'max_features':['sqrt', 'log2'],
    'min_samples_split':[4, 8, 12],
    'min_samples_leaf':[2, 4, 8],
    'bootstrap':[True]
}

grid_search_rf = GridSearchCV(
    estimator=RandomForestRegressor(random_state=42),
    param_grid=param_grid,
    cv=5,
    scoring='r2',
    n_jobs=-1
)

grid_search_rf.fit(X_train_scaled, y_train)
best_rf_model = grid_search_rf.best_estimator_
print(f"\nBest Parameters: {grid_search_rf.best_params_}")
print(f"Best CV R²: {grid_search_rf.best_score_:.4f}")


# -------------------------------------------------------
# 8. Evaluate tuned RF
# -------------------------------------------------------
y_pred_train_rf = best_rf_model.predict(X_train_scaled)
y_pred_rf = best_rf_model.predict(X_test_scaled)

joblib.dump(best_rf_model, "rf_model.pkl")
joblib.dump(scaler, "rf_scaler.pkl")

print("Saved: rf_model.pkl and rf_scaler.pkl")


mse_train_rf = mean_squared_error(y_train, y_pred_train_rf)
mse_test_rf = mean_squared_error(y_test, y_pred_rf)
plt.figure(figsize=(6,5))
plt.bar(['Train RMSE', 'Test RMSE'], [np.sqrt(mse_train_rf), np.sqrt(mse_test_rf)], color=['skyblue', 'orange'])
plt.ylabel("RMSE")
plt.title("Train vs Test Error (RF)")
plt.tight_layout()
plt.savefig("rf_train_vs_test_rmse.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 9. Feature importances
# -------------------------------------------------------e
rf_importance = best_rf_model.feature_importances_
importance_df_rf = pd.DataFrame({'Feature': X_train.columns, 'Importance': rf_importance})
top20_rf = importance_df_rf.sort_values(by='Importance', ascending=False).head(20)

plt.figure(figsize=(8,6))
plt.barh(top20_rf['Feature'], top20_rf['Importance'])
plt.gca().invert_yaxis()
plt.xlabel("Feature Importance")
plt.ylabel("Feature")
plt.title("Top 20 Feature Importances — RF")
plt.tight_layout()
plt.savefig("rf_top20_feature_importance.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 10. Predicted vs True Scatter
# -------------------------------------------------------
plt.figure(figsize=(6,6))
plt.scatter(y_test, y_pred_rf, alpha=0.7, color='green')
min_val = min(y_test.min(), y_pred_rf.min())
max_val = max(y_test.max(), y_pred_rf.max())
plt.plot([min_val, max_val], [min_val, max_val], 'r--', label="Perfect Prediction")
plt.xlabel("True CO₂ Loading")
plt.ylabel("Predicted CO₂ Loading")
plt.title("Predicted vs True CO₂ Loading (RF)")
plt.legend()
plt.tight_layout()
plt.savefig("rf_pred_vs_true.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 11. Train vs Test RMSE
# -------------------------------------------------------
plt.figure(figsize=(6,5))
plt.bar(['Train RMSE','Test RMSE'], [np.sqrt(mse_train_rf), np.sqrt(mse_test_rf)], color=['skyblue','orange'])
plt.ylabel("RMSE")
plt.title("Train vs Test Error (RF)")
plt.tight_layout()
plt.savefig("rf_train_vs_test_rmse.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 12. Residual Plot
# -------------------------------------------------------
residuals_rf_test = y_test - y_pred_rf
plt.figure(figsize=(6,5))
plt.scatter(y_pred_rf, residuals_rf_test, alpha=0.6)
plt.axhline(0, color='red', linestyle='--')
plt.xlabel("Predicted CO₂ Loading")
plt.ylabel("Residual (True - Predicted)")
plt.title("Residual Plot (RF)- Test")
plt.tight_layout()
plt.savefig("rf_residuals.png", dpi=300)
plt.show()

residuals_rf_train = y_train - y_pred_train_rf
plt.figure(figsize=(6,5))
plt.scatter(y_pred_train_rf, residuals_rf_train, alpha =0.6)
plt.axhline(0, color='red', linestyle='--')
plt.xlabel("Predicted CO₂ Loading")
plt.ylabel("Residual (True - Predicted)")
plt.title("Residual Plot (RF) – Train")
plt.tight_layout()
plt.savefig("rf_residuals_train.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 13. Learning Curve
# -------------------------------------------------------
train_sizes, train_scores, test_scores = learning_curve(
    best_rf_model, X_train_scaled, y_train, cv=5, scoring='r2', train_sizes=np.linspace(0.2,1.0,5)
)
train_mean = train_scores.mean(axis=1)
test_mean = test_scores.mean(axis=1)

plt.figure(figsize=(6,5))
plt.plot(train_sizes, train_mean, marker='o', label='Train R²')
plt.plot(train_sizes, test_mean, marker='s', label='CV R²')
plt.xlabel("Training Samples Used")
plt.ylabel("R² Score")
plt.title("Learning Curve (RF)")
plt.legend()
plt.tight_layout()
plt.savefig("rf_learning_curve.png", dpi=300)
plt.show()

# -------------------------------------------------------
# 14. CV R² Error Bar
# -------------------------------------------------------
plt.figure(figsize=(6,5))
plt.errorbar([0], [cv_r2_rf.mean()], yerr=[cv_r2_rf.std()], fmt='o', capsize=5)
plt.xticks([0], ['Random Forest'])
plt.ylabel("R² Score")
plt.title("Cross-Validation R² with Error Bars (RF)")
plt.tight_layout()
plt.savefig("rf_cv_r2_errorbar.png", dpi=300)
plt.show()
#--------------------------------------------------------
# 15. Training and validation loss graph
#--------------------------------------------------------
rf = RandomForestRegressor(n_estimators=1, max_depth=None, random_state=42, warm_start=True)

train_mse = []
val_mse = []

# Fit trees incrementally
for n_trees in range(1, 501):  # 1 to 500 trees
    rf.n_estimators = n_trees
    rf.fit(X_train_scaled, y_train)

    train_mse.append(mean_squared_error(y_train, rf.predict(X_train_scaled)))
    val_mse.append(mean_squared_error(y_test, rf.predict(X_test_scaled)))

plt.figure(figsize=(8,5))
plt.plot(np.sqrt(train_mse), label='Train RMSE')
plt.plot(np.sqrt(val_mse), label='Validation RMSE')
plt.xlabel('Number of Trees')
plt.ylabel('RMSE')
plt.title('Random Forest Training vs Validation Loss')
plt.legend()
plt.grid(True)
plt.savefig("rf_train_vs_val_loss.png", dpi=300)
plt.show()
print("Plot saved as rf_train_vs_val_loss.png")
#----------------------------------------------------------
#16. Parity plots for forest 
#---------------------------------------------------------
# Predictions using FINAL tuned RF model
rf_train_pred = best_rf_model.predict(X_train_scaled)
rf_test_pred  = best_rf_model.predict(X_test_scaled)

# Shared axis limits
y_all = np.concatenate([y_train, y_test])
ymin, ymax = y_all.min(), y_all.max()

def parity_plot(y_true, y_pred, title, filename, ymin, ymax):
    plt.figure(figsize=(5,5))
    plt.scatter(y_true, y_pred, alpha=0.6)

    # 45-degree reference line
    plt.plot([ymin, ymax], [ymin, ymax], 'r--', linewidth=2)

    plt.xlim(ymin, ymax)
    plt.ylim(ymin, ymax)

    plt.gca().set_aspect('equal', adjustable='box')

    plt.xlabel("True CO₂ Loading", fontsize=13)
    plt.ylabel("Predicted CO₂ Loading", fontsize=13)
    plt.title(title)

    plt.tight_layout()
    plt.savefig(filename, dpi=300)
    plt.show()


